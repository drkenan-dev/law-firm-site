# Public site URL (used for metadata, sitemap and canonical links).
# Example: https://www.yourlawfirm.com
NEXT_PUBLIC_SITE_URL=https://www.yourlawfirm.com

# WordPress content source (used only during `npm run build` / `npm run dev`).
# Set this to your WordPress home URL to pull content from the CMS.
# When unset (or unreachable), the site builds from the seed data in src/data/.
# Example: https://www.yourlawfirm.com/wp
WP_API_URL=